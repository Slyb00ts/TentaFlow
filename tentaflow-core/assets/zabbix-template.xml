    <templates>
        <template>
            <uuid>ef7cecb08e974f55921c7a1b0465aeec</uuid>
            <template>TentaFlow Node</template>
            <name>TentaFlow Node</name>
            <description>Per-node operational metrics exported by TentaFlow at GET /v1/metrics/zabbix (Authorization: Bearer &lt;monitoring_zabbix_token&gt;). One host per TentaFlow node -- this template does not aggregate mesh peers. Set {$TENTAFLOW.METRICS.URL} and {$TENTAFLOW.METRICS.TOKEN} on the host before enabling; review {$TENTAFLOW.METRICS.TLS_VERIFY} if the node uses its default self-signed per-installation certificate.</description>
            <groups>
                <group>
                    <name>Templates/Applications</name>
                </group>
            </groups>
            <items>
                <item>
                    <uuid>ba04570431b44003b468b5aaf8b87327</uuid>
                    <name>TentaFlow metrics (raw)</name>
                    <type>HTTP_AGENT</type>
                    <key>tentaflow_metrics_raw</key>
                    <delay>60s</delay>
                    <history>0</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                    <url>{$TENTAFLOW.METRICS.URL}</url>
                    <headers>
                        <header>
                            <name>Authorization</name>
                            <value>Bearer {$TENTAFLOW.METRICS.TOKEN}</value>
                        </header>
                    </headers>
                    <status_codes>200</status_codes>
                    <timeout>10s</timeout>
                    <verify_peer>{$TENTAFLOW.METRICS.TLS_VERIFY}</verify_peer>
                    <verify_host>{$TENTAFLOW.METRICS.TLS_VERIFY}</verify_host>
                    <description>Raw text/plain body of GET /v1/metrics/zabbix -- one &quot;key value&quot; pair per line (label-less Prometheus exposition). Every other item in this template is a dependent item that extracts one line via Prometheus-pattern preprocessing; this item itself is not meant to be graphed (history disabled).</description>
                </item>
