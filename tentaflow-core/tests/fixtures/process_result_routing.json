{
  "description": "Where each outcome of a BPMN Service task goes. Read by the designer's routing table (www/js/modules/flows-builder/bpmn.test.js) and by the engine test processes::result_routing_tests, so a rule that changes on one side turns the other red. A case builds a Service task with the given boundary events, feeds it the stimulus, and states the table row (expect: route, optional code/reason/boundary/warning, and text, the i18n keys of the row's two cells) and the engine fact (engine). stimuli[].row names the table row a stimulus lands on. routeFacts lists, per route, the engine facts that can honour it; both test suites assert every case against it. engine=null means no engine probe exists for the row; engineReason says why. Facts: verification = one open verification task for the initiator showing the given result outcome and code, instance running; advanced = the instance completed without incident; incident = the given incident code, no boundary caught it, instance in Incident, no open verification task; boundary = caught by that node alone; propagated = climbed to that enclosing boundary. nested puts the task inside a sub-process; scopeCatch says whether that sub-process carries a catch-all error boundary event.",
  "stimuli": {
    "completed": {
      "text": "the result source returns a Completed result",
      "row": "completed"
    },
    "rejected": {
      "text": "the result is Completed but the verifier says no (Human: the task is rejected, Condition: it evaluates to false)",
      "row": "rejected"
    },
    "error": {
      "text": "a result rule returns Error with the given code",
      "row": "error"
    },
    "needs_human": {
      "text": "a result rule returns NeedsHuman with the given code",
      "row": "needs_human"
    },
    "cancelled": {
      "text": "a result rule returns Cancelled",
      "row": "cancelled"
    },
    "tool_error": {
      "text": "the addon tool fails: a platform result, not a result rule outcome",
      "row": "platform"
    },
    "bad_result_rule": {
      "text": "the result rule does not return an ActivityResult: a platform result",
      "row": "platform"
    },
    "denied": {
      "text": "the initiator lost the addon permission, found at claim time",
      "row": "denied"
    },
    "timeout": {
      "text": "the task runs past timeoutSeconds after dispatch",
      "row": "timeout"
    }
  },
  "cases": [
    {
      "name": "Human review of a completed result opens the verification task",
      "task": {
        "kind": "tool",
        "resultExpression": false,
        "verification": "Human"
      },
      "stimulus": {
        "type": "completed"
      },
      "expect": {
        "route": "next",
        "text": {
          "outcome": "bpmn.routing_outcome_completed",
          "route": "bpmn.routing_next_human"
        }
      },
      "engine": {
        "fact": "verification",
        "outcome": "Completed"
      }
    },
    {
      "name": "An accepting condition lets the process go on",
      "task": {
        "kind": "tool",
