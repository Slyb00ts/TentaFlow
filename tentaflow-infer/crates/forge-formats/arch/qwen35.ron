// =============================================================================
// Plik: qwen35.ron
// Opis: Rejestruje globalne tensory gęstej hybrydy Qwen3.5/3.6.
// Przykład: Metadane GGUF general.architecture="qwen35" wybierają ten wpis.
// =============================================================================
(
    name: "qwen35",
    gguf_arch: "qwen35",
    hf_architectures: ["Qwen35ForCausalLM"],
    hf_model_types: ["qwen35"],
    roles: [
        (role: TokenEmbd, gguf: "token_embd.weight", hf: "model.embed_tokens.weight", per_layer: false, required: true),
        (role: OutputNorm, gguf: "output_norm.weight", hf: "model.norm.weight", per_layer: false, required: true),
        (role: LmHead, gguf: "output.weight", hf: "lm_head.weight", per_layer: false, required: false),
        (role: AttnNorm, gguf: "blk.{layer}.attn_norm.weight", hf: "model.layers.{layer}.input_layernorm.weight", per_layer: true, required: true),
        (role: AttnQ, gguf: "blk.{layer}.attn_q.weight", hf: "model.layers.{layer}.self_attn.q_proj.weight", per_layer: true, required: true),
        (role: AttnK, gguf: "blk.{layer}.attn_k.weight", hf: "model.layers.{layer}.self_attn.k_proj.weight", per_layer: true, required: true),
        (role: AttnV, gguf: "blk.{layer}.attn_v.weight", hf: "model.layers.{layer}.self_attn.v_proj.weight", per_layer: true, required: true),
        (role: AttnO, gguf: "blk.{layer}.attn_output.weight", hf: "model.layers.{layer}.self_attn.o_proj.weight", per_layer: true, required: true),
        (role: AttnQNorm, gguf: "blk.{layer}.attn_q_norm.weight", hf: "model.layers.{layer}.self_attn.q_norm.weight", per_layer: true, required: true),
        (role: AttnKNorm, gguf: "blk.{layer}.attn_k_norm.weight", hf: "model.layers.{layer}.self_attn.k_norm.weight", per_layer: true, required: true),
        (role: FfnNorm, gguf: "blk.{layer}.post_attention_norm.weight", hf: "model.layers.{layer}.post_attention_layernorm.weight", per_layer: true, required: true),
        (role: FfnGate, gguf: "blk.{layer}.ffn_gate.weight", hf: "model.layers.{layer}.mlp.gate_proj.weight", per_layer: true, required: true),
        (role: FfnUp, gguf: "blk.{layer}.ffn_up.weight", hf: "model.layers.{layer}.mlp.up_proj.weight", per_layer: true, required: true),
        (role: FfnDown, gguf: "blk.{layer}.ffn_down.weight", hf: "model.layers.{layer}.mlp.down_proj.weight", per_layer: true, required: true),
    ],
)
