{
  "meta": {
    "name": "TentaFlow design tokens",
    "version": "2.0.0",
    "updated": "2026-09-14",
    "status": "canonical",
    "notes": [
      "Single source of truth for every colour, size, radius, shadow, motion and layout value used by the HTML dashboard (www/css), the addon UI protocol (tentaflow-sdk-spec::protocol::ui::tokens) and the native TentaEngine theme (tentaflow-ui-native).",
      "Values were taken from the LIVE stylesheets on 2026-09-14 (tentaflow-core/www/css/style.css :root and controls.css :root), not from the April 2026 DESIGN.md, which described a token vocabulary that never existed in code.",
      "Where style.css and controls.css disagreed, the app-shell value from style.css won; the deviation is listed in design/MIGRATION.md.",
      "Semantic names mirror the string enums in tentaflow-sdk-spec/src/protocol/ui/tokens.rs (Tone, Spacing, TextStyle, RadiusToken, ShadowToken, Breakpoint, IconSize) so one vocabulary covers CSS, the CBOR protocol and Rust.",
      "Generated artefacts (planned, see design/README.md): www/css/tokens.css and tentaflow-ui-native/src/theme_generated.rs. Until the generator exists, edit this file first and mirror by hand."
    ]
  },

  "color": {
    "themes": {
      "dark": {
        "status": "canonical",
        "bg": {
          "base":        { "value": "#050818", "role": "app background",                       "css": "--bg" },
          "raised":      { "value": "#0a0d24", "role": "sidebar, topbar",                      "css": "--bg-2" },
          "elevated":    { "value": "#111535", "role": "elevated panels, secondary buttons",   "css": "--bg-3" },
          "card":        { "value": "#141836", "role": "card surfaces",                        "css": "--bg-card" },
          "card_hover":  { "value": "#1a1f45", "role": "interactive hover state",              "css": "--bg-card-hover" },
          "input":       { "value": "#0b0e22", "role": "form inputs, code blocks",             "css": "--bg-input" },
          "overlay":     { "value": "rgba(0, 0, 0, 0.80)", "role": "modal scrim (with 8px backdrop blur on web)" }
        },
        "text": {
          "primary":     { "value": "#e8ebf5", "role": "body text",         "css": "--text",   "contrast_on_bg_base": "15.4:1" },
          "secondary":   { "value": "#a0a8c8", "role": "labels, metadata",  "css": "--text-2", "contrast_on_bg_base": "8.2:1" },
          "muted":       { "value": "#6a7196", "role": "hints, disabled — decorative only, never body copy", "css": "--text-3", "contrast_on_bg_base": "3.9:1" },
          "inverse":     { "value": "#050818", "role": "text on accent-filled surfaces" },
          "on_accent":   { "value": "#ffffff", "role": "text on primary buttons", "contrast_on_accent": "4.7:1" }
        },
        "border": {
          "default":     { "value": "#1f2548", "css": "--border" },
          "hover":       { "value": "#2f3668", "css": "--border-hover" },
          "focus":       { "value": "#6366f1", "role": "focus ring colour = accent.primary" }
        },
        "accent": {
          "primary":       { "value": "#6366f1", "role": "indigo — primary actions, links, focus", "css": "--accent-1" },
          "primary_hover": { "value": "#818cf8", "css": "--tf-accent-2 (controls.css)" },
          "secondary":     { "value": "#a78bfa", "role": "lilac — brand accent for hero/gradients, never UI chrome", "css": "--accent-2" },
          "glow":          { "value": "rgba(99, 102, 241, 0.18)", "css": "--accent-glow" },
          "soft":          { "value": "rgba(99, 102, 241, 0.15)", "role": "selected rows, soft badges" }
        },
        "semantic": {
          "success":  { "value": "#22c55e", "soft": "rgba(34, 197, 94, 0.15)",  "role": "online, granted, saved" },
          "warning":  { "value": "#f59e0b", "soft": "rgba(245, 158, 11, 0.15)", "role": "pending, degraded, beta" },
          "critical": { "value": "#ef4444", "soft": "rgba(239, 68, 68, 0.15)",  "hover": "#dc2626", "role": "errors, destructive actions", "css": "--danger" },
          "info":     { "value": "#60a5fa", "soft": "rgba(96, 165, 250, 0.15)", "role": "informational, remote/tailscale", "css": "--info" }
        },
        "tone": {
          "_comment": "Resolution of the sdk-spec `Tone` enum onto concrete colours. fg = text/icon/stroke, bg = soft fill.",
          "neutral":  { "fg": "{color.themes.dark.text.secondary}",  "bg": "{color.themes.dark.bg.elevated}" },
          "primary":  { "fg": "{color.themes.dark.accent.primary}",  "bg": "{color.themes.dark.accent.soft}" },
          "success":  { "fg": "{color.themes.dark.semantic.success.value}",  "bg": "{color.themes.dark.semantic.success.soft}" },
          "warning":  { "fg": "{color.themes.dark.semantic.warning.value}",  "bg": "{color.themes.dark.semantic.warning.soft}" },
          "critical": { "fg": "{color.themes.dark.semantic.critical.value}", "bg": "{color.themes.dark.semantic.critical.soft}" },
          "info":     { "fg": "{color.themes.dark.semantic.info.value}",     "bg": "{color.themes.dark.semantic.info.soft}" },
          "muted":    { "fg": "{color.themes.dark.text.muted}",      "bg": "transparent" }
        },
        "gradient": {
          "accent":  { "value": "linear-gradient(135deg, #6366f1 0%, #a78bfa 100%)", "css": "--gradient-accent" },
          "logo":    { "value": "linear-gradient(90deg, #ffffff 0%, #60a5fa 50%, #a78bfa 100%)", "css": "--gradient-logo" },
          "soft":    { "value": "linear-gradient(135deg, rgba(99,102,241,0.15) 0%, rgba(167,139,250,0.12) 100%)", "css": "--gradient-soft" }
        },
        "voice": {
          "_comment": "Voice-chat state machine colours (chat-audio). Domain palette, not core chrome.",
          "listen": { "value": "#22c55e", "glow": "rgba(34, 197, 94, 0.45)",  "gradient": "linear-gradient(135deg, #22c55e 0%, #06b6d4 100%)" },
          "think":  { "value": "#f59e0b", "glow": "rgba(245, 158, 11, 0.40)" },
          "speak":  { "value": "#a78bfa", "glow": "rgba(167, 139, 250, 0.55)", "gradient": "linear-gradient(135deg, #a78bfa 0%, #6366f1 100%)" }
        }
      },
      "light": {
        "status": "draft — not shipped; values chosen for contrast parity with dark, to be validated visually before enabling [data-theme=light]",
        "bg": {
          "base":       { "value": "#f7f8fc" },
          "raised":     { "value": "#ffffff" },
          "elevated":   { "value": "#eef0f7" },
          "card":       { "value": "#ffffff" },
          "card_hover": { "value": "#f0f2fa" },
          "input":      { "value": "#ffffff" },
          "overlay":    { "value": "rgba(10, 13, 36, 0.55)" }
        },
        "text": {
          "primary":   { "value": "#141836" },
          "secondary": { "value": "#4a5178" },
          "muted":     { "value": "#8087a8" },
          "inverse":   { "value": "#ffffff" },
          "on_accent": { "value": "#ffffff" }
        },
        "border": {
          "default": { "value": "#dfe3f0" },
          "hover":   { "value": "#c4cade" },
          "focus":   { "value": "#4f52d9" }
        },
        "accent": {
          "primary":       { "value": "#4f52d9" },
          "primary_hover": { "value": "#6366f1" },
          "secondary":     { "value": "#8b6cf0" },
          "glow":          { "value": "rgba(79, 82, 217, 0.15)" },
          "soft":          { "value": "rgba(79, 82, 217, 0.12)" }
        },
        "semantic": {
          "success":  { "value": "#15803d", "soft": "rgba(21, 128, 61, 0.12)" },
          "warning":  { "value": "#b45309", "soft": "rgba(180, 83, 9, 0.12)" },
          "critical": { "value": "#b91c1c", "soft": "rgba(185, 28, 28, 0.12)", "hover": "#991b1b" },
          "info":     { "value": "#1d4ed8", "soft": "rgba(29, 78, 216, 0.12)" }
        }
      }
    },
    "dataviz": {
      "_comment": "Chart palettes. Categorical order is fixed so series keep their colour across pages. Sourced from --gpu-group-0..5 in style.css.",
      "categorical": ["#22c55e", "#60a5fa", "#f59e0b", "#a78bfa", "#06b6d4", "#f472b6"],
      "sequential_accent": ["#0b0e22", "#1e1b4b", "#3730a3", "#4f46e5", "#6366f1", "#818cf8", "#a5b4fc", "#c7d2fe"],
      "diverging": ["#ef4444", "#f59e0b", "#6a7196", "#60a5fa", "#22c55e"],
      "heat": ["#0b0e22", "#312e81", "#6366f1", "#a78bfa", "#f472b6", "#fde68a"],
      "grid_line": "#1f2548",
      "axis_text": "#a0a8c8"
    }
  },

  "typography": {
    "family": {
      "sans": { "value": "Manrope", "fallback": ["-apple-system", "BlinkMacSystemFont", "Segoe UI", "system-ui", "sans-serif"], "weights": [400, 500, 600, 700, 800], "source": "Google Fonts today; self-hosted subset planned (design/foundations/typography.md)" },
      "mono": { "value": "JetBrains Mono", "fallback": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"], "weights": [400, 600], "decision": "JetBrains Mono is canonical; the parallel 'SF Mono' stack in style.css is retired (design/MIGRATION.md)" }
    },
    "scale": {
      "_comment": "Keyed by the sdk-spec `TextStyle` enum. size/line_height in logical px; weight is Manrope weight; tracking in em. Native renderer rounds size*scale_factor to whole device px.",
      "display":        { "size": 32, "line_height": 38, "weight": 800, "tracking": -0.02 },
      "title":          { "size": 24, "line_height": 30, "weight": 700, "tracking": -0.01 },
      "h1":             { "size": 20, "line_height": 26, "weight": 700, "tracking": -0.01 },
      "h2":             { "size": 16, "line_height": 22, "weight": 600, "tracking": 0 },
      "h3":             { "size": 14, "line_height": 20, "weight": 600, "tracking": 0 },
      "h4":             { "size": 13, "line_height": 18, "weight": 600, "tracking": 0 },
      "body_lg":        { "size": 14, "line_height": 21, "weight": 400, "tracking": 0 },
      "body":           { "size": 13, "line_height": 20, "weight": 400, "tracking": 0 },
      "body_strong":    { "size": 13, "line_height": 20, "weight": 600, "tracking": 0 },
      "caption":        { "size": 11, "line_height": 16, "weight": 400, "tracking": 0 },
      "caption_strong": { "size": 11, "line_height": 16, "weight": 600, "tracking": 0 },
      "overline":       { "size": 10, "line_height": 14, "weight": 700, "tracking": 0.08, "transform": "uppercase" },
      "code":           { "size": 12, "line_height": 19, "weight": 400, "family": "mono" },
      "mono":           { "size": 12, "line_height": 18, "weight": 400, "family": "mono" },
      "quote":          { "size": 13, "line_height": 20, "weight": 400, "style": "italic" }
    },
    "rules": {
      "min_body_size_px": 13,
      "min_any_size_px": 10,
      "half_pixel_sizes": "forbidden — 11.5/12.5/10.5px in legacy CSS are migration debt",
      "text_selection": "allowed everywhere except on buttons, icons and drag handles"
    }
  },

  "spacing": {
    "_comment": "Keyed by the sdk-spec `Spacing` enum. Base unit 4px. Layout-only extras (section, page) are not part of the enum.",
    "zero": 0, "xxs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24, "xxl": 32,
    "layout": { "section": 48, "page": 64 }
  },

  "radius": {
    "_comment": "Keyed by the sdk-spec `RadiusToken` enum.",
    "none": 0, "xs": 4, "sm": 6, "md": 10, "lg": 14, "xl": 20, "pill": 9999, "circle": "50%",
    "usage": { "xs": "checkbox, tags, code chips", "sm": "badges, small inputs", "md": "buttons, inputs, small cards (css --radius)", "lg": "cards, modals", "xl": "hero blocks", "pill": "status pills, segmented controls", "circle": "avatars, icon buttons only" }
  },

  "elevation": {
    "_comment": "Keyed by the sdk-spec `ShadowToken` enum. On the CPU/ESP32-P4 renderer shadows are flattened to a 1px border of border.default — no live blur.",
    "none":     { "value": "none" },
    "subtle":   { "value": "0 2px 6px rgba(0, 0, 0, 0.40)",  "role": "cards at rest" },
    "medium":   { "value": "0 8px 24px rgba(0, 0, 0, 0.50)", "role": "hover, dropdowns, popovers" },
    "elevated": { "value": "0 16px 48px rgba(0, 0, 0, 0.70)", "role": "modals, drawers" },
    "floating": { "value": "0 24px 64px rgba(0, 0, 0, 0.70), 0 8px 24px rgba(99, 102, 241, 0.15)", "role": "command palette, floating windows" },
    "accent_glow": { "value": "0 0 14px rgba(99,102,241,0.55), 0 0 28px rgba(99,102,241,0.35), 0 0 52px rgba(99,102,241,0.18), 0 0 84px rgba(99,102,241,0.08)", "role": "hero mascot, active voice orb" },
    "glow_success": { "value": "0 0 12px rgba(34,197,94,0.35), 0 0 28px rgba(34,197,94,0.18)" },
    "glow_critical": { "value": "0 0 14px rgba(239,68,68,0.55), 0 0 28px rgba(239,68,68,0.35), 0 0 52px rgba(239,68,68,0.18)" }
  },

  "border": {
    "_comment": "Keyed by the sdk-spec `BorderToken` union.",
    "hairline": { "width": 1, "color": "{color.themes.dark.border.default}" },
    "thin":     { "width": 1, "color": "{color.themes.dark.border.hover}" },
    "strong":   { "width": 2, "color": "{color.themes.dark.border.hover}" },
    "accent":   { "width": 1, "color": "tone.fg" }
  },

  "motion": {
    "duration_ms": { "instant": 0, "fast": 120, "normal": 200, "slow": 300, "deliberate": 450 },
    "easing": {
      "standard":   { "value": "cubic-bezier(0.32, 0.72, 0, 1)",   "role": "default for colour/transform changes", "css": "--tf-spring-smooth" },
      "emphasized": { "value": "cubic-bezier(0.16, 1, 0.3, 1)",    "role": "entrances (modal, drawer, toast)" },
      "exit":       { "value": "cubic-bezier(0.7, 0, 0.84, 0)",    "role": "exits" },
      "overshoot":  { "value": "cubic-bezier(0.34, 1.56, 0.64, 1)", "role": "playful confirmations only", "css": "--tf-spring-snappy" }
    },
    "spring": {
      "_comment": "Native (TentaEngine) implicit animations use springs, not durations. mass = 1.",
      "snappy": { "stiffness": 400, "damping": 30 },
      "gentle": { "stiffness": 170, "damping": 26 },
      "slow":   { "stiffness": 90,  "damping": 20 }
    },
    "reduced_motion": "all durations → 0ms, springs → snap to target; mandatory on every platform"
  },

  "layout": {
    "breakpoints_px": { "_comment": "Keyed by the sdk-spec `Breakpoint` enum; min-width, mobile first.", "xs": 640, "sm": 768, "md": 1024, "lg": 1280, "xl": 1536, "xxl": 1920 },
    "sidebar":  { "expanded": 240, "collapsed": 64, "collapse_below": "md" },
    "topbar":   { "height": 56 },
    "content":  { "max_width": 1440, "narrow": 800 },
    "grid":     { "columns": 12, "gutter": "{spacing.lg}" },
    "z_index":  { "base": 0, "sticky": 10, "dropdown": 100, "overlay": 1000, "modal": 1100, "toast": 1200, "tooltip": 1300 }
  },

  "control": {
    "height": { "sm": 28, "md": 36, "lg": 44 },
    "touch_target_min": 44,
    "focus_ring": { "width": 2, "offset": 2, "color": "{color.themes.dark.border.focus}" },
    "icon_size": { "_comment": "Keyed by the sdk-spec `IconSize` enum.", "xs": 12, "sm": 16, "md": 20, "lg": 24, "xl": 32 },
    "icon_stroke": { "default": 1.75, "small": 2.0, "large": 1.5 },
    "density": { "compact": 0.9, "default": 1.0, "comfortable": 1.15 }
  },

  "material": {
    "_comment": "Surface materials. `glass` is the Liquid Glass-style material (design/foundations/materials.md, TentaEngine docs/UI_TOOLKIT_SPEC.md §5.4). Values in logical px / unitless; the CPU 'glass lite' path uses the same parameters with LUT approximations, `Flat` never samples the backdrop.",
    "glass": {
      "regular":  { "blur_px": 24, "ior": 1.15, "thickness_px": 6, "edge_width_px": 14, "tint_strength": 0.25, "dispersion_px": 1.0, "fresnel_power": 3.0, "rim_strength": 0.35, "specular_strength": 0.45, "shininess": 48, "shadow": "{elevation.medium}" },
      "clear":    { "blur_px": 8,  "ior": 1.10, "thickness_px": 4, "edge_width_px": 10, "tint_strength": 0.08, "dispersion_px": 0.6, "fresnel_power": 3.5, "rim_strength": 0.25, "specular_strength": 0.35, "shininess": 64, "shadow": "{elevation.subtle}" },
      "tinted":   { "_comment": "regular + tone.bg mixed at tint_strength 0.45; fg text uses tone.fg", "tint_strength": 0.45 },
      "flat":     { "_comment": "fallback: no backdrop sampling", "fill": "rgba(20, 24, 54, 0.82)", "fill_light": "rgba(255, 255, 255, 0.78)", "rim": "{color.themes.dark.border.hover}", "highlight_gradient": "linear-gradient(160deg, rgba(255,255,255,0.10) 0%, rgba(255,255,255,0.0) 55%)" },
      "tint_dark":  "rgba(5, 8, 24, 1.0)",
      "tint_light": "rgba(245, 246, 255, 1.0)",
      "adaptive_luminance_threshold": 0.45,
      "light": { "_comment": "LightDir source per platform; azimuth/elevation in degrees at rest", "rest_azimuth_deg": 300, "rest_elevation_deg": 55, "imu_gain": 0.8, "imu_lowpass_hz": 6, "pointer_gain": 0.3 },
      "morph": { "spring": "{motion.spring.gentle}", "smin_k_px": 12 },
      "max_levels": 3,
      "reduce_transparency": "→ flat with tint_strength 0.9",
      "allowed_on": ["floating bars (tab/tool/nav)", "buttons and chips over media or 3D", "cards over images/video/maps", "overlays: toast, popover, command palette"],
      "forbidden_on": ["tables and data grids", "forms and text fields", "long-form text containers", "anything the user must read at a glance on a dense background"]
    }
  },

  "platform": {
    "_comment": "Per-platform presentation constants consumed by the native theme; the app code never reads these directly.",
    "web_desktop":  { "scale_factor": "devicePixelRatio", "density": "default", "pointer": "fine", "glass": "full (GPU) | lite (CPU fallback)", "light_source": "pointer" },
    "mobile_phone": { "scale_factor": "os", "density": "comfortable", "pointer": "coarse", "min_touch_target": 44, "glass": "full", "light_source": "imu" },
    "tablet":       { "scale_factor": "os", "density": "default", "pointer": "coarse", "glass": "full", "light_source": "imu" },
    "esp32p4_tab5": { "panel_px": [720, 1280], "dpi": 220, "format": "RGB565", "scale_factor": 1.5, "density": "comfortable", "pointer": "coarse", "shadows": "flat", "fonts": "Latin+Polish subset, 4 styles × 2 weights baked at device px", "glass": "lite", "glass_max_area_px": 180000, "glass_budget_status": "estimate until HIL", "light_source": "imu (BMI270)" },
    "esp32p4_jc8012": { "panel_px": [800, 1280], "dpi": 150, "format": "RGB565", "scale_factor": 1.0, "density": "comfortable", "pointer": "coarse", "shadows": "flat", "glass": "lite", "glass_max_area_px": 180000, "glass_budget_status": "estimate until HIL", "light_source": "rest" },
    "esp32p4_jc4880": { "panel_px": [480, 800],  "dpi": 220, "format": "RGB565", "scale_factor": 1.5, "density": "default",     "pointer": "coarse", "shadows": "flat", "glass": "lite (no dispersion)", "glass_max_area_px": 60000, "glass_budget_status": "estimate until HIL", "light_source": "rest" }
  }
}
