# --- WASI SDK (C# addons compiled by NativeAOT-LLVM) -----------------------------
# Pinned to the version DOTNET_ILCOMPILER_LLVM_VERSION is built for (its
# Microsoft.NETCore.Native.Wasm.targets names it): newer wasm-ld rejects the
# linker flags that compiler emits. Bump both together.
WASI_SDK_VERSION=29.0
WASI_SDK_SHA256_LINUX_X86_64=87d1d1a2879d139cdc624b968efad3d4a97b8078cdff95e63ac88ecafd1a0171
WASI_SDK_SHA256_LINUX_ARM64=052ad773397dc9e5aa99fb4cfef694175e6b1e81bb2ad1d3c8e7b3fc81441b7c
WASI_SDK_SHA256_MACOS_X86_64=d0de2fd3ea5c57060efa87e4356c164bec3689972f2386f0c9a89c58e10cec8d
WASI_SDK_SHA256_MACOS_ARM64=e11552913e3f99e834d7fe7da1bd081abaf764759ed76b6097a34c63fc83665e
WASI_SDK_SHA256_WINDOWS_X86_64=6c19b820577486f00332ad8d04ac506da67b0892316b8d485371a58cbf216dee

# --- .NET (C# addons) -----------------------------------------------------------
DOTNET_SDK_CHANNEL=10.0
# NativeAOT-LLVM compiler from the dotnet-experimental feed.
DOTNET_ILCOMPILER_LLVM_VERSION=10.0.0-rc.1.26357.1

# --- GStreamer (camera pipeline) ------------------------------------------------
# Windows MSI (winget), Android universal SDK and iOS xcframework.
GSTREAMER_VERSION=1.28.6
# GLib bundled in the iOS xcframework of that release (synthetic .pc files).
GSTREAMER_IOS_GLIB_VERSION=2.82.4

# --- GPU toolkits installed by setup ---------------------------------------------
# The newest toolkit every CUDA consumer supports: cudarc (burn/cubecl vision,
# forge-hal) knows CUDA only up to 13.3 and refuses to build against 13.4.
CUDA_TOOLKIT_VERSION=13.3
VULKAN_SDK_VERSION=1.4.357.0
