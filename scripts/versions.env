# ===== File: scripts/versions.env — single source of native library and toolchain versions =====
#
# Every build and setup script reads its pins from here: bash through
# scripts/lib/versions.sh, PowerShell through scripts/lib/windows.ps1, MSBuild
# through tentaflow-core/addons/Directory.Build.props. A version lives in this
# file exactly once; bumping a library means editing its line (and the
# checksums right next to it) and nothing else.
#
# Format: KEY=value, one per line, no quotes and no spaces around '='. Lines
# starting with '#' are comments. Checksums are SHA-256 of the exact artifact
# named in the comment above them. An environment variable with the same name
# overrides the file for one run (bisecting a regression); checksums of an
# overridden artifact are then unknown and the scripts refuse to guess them.
#
# Rust crate versions are NOT here: they belong to the root Cargo.toml.

# --- llama.cpp -----------------------------------------------------------------
LLAMA_CPP_REF=v0.4.1

# --- whisper.cpp ---------------------------------------------------------------
WHISPER_CPP_REF=v1.9.4

# --- sherpa-onnx ---------------------------------------------------------------
SHERPA_ONNX_REF=v1.13.8
# iOS links the static ONNX Runtime xcframework sherpa-onnx itself is released
# against (build-ios.sh of the same sherpa tag).
SHERPA_ONNX_IOS_ORT_VERSION=1.28.2
# onnxruntime-ios-static-xcframework-1.28.2.xcframework.zip (csukuangfj/onnxruntime-libs)
SHERPA_ONNX_IOS_ORT_SHA256=2c2299acbb461d26d4bac4bc85985d40e7c7177ed6072703ae0846d88b0b4599

# --- zvec (embedded vector database) -------------------------------------------
ZVEC_REF=v0.7.0
# zvec-sdk-windows-amd64.zip — Windows uses the official prebuilt SDK: its
# zvec_c_api.dll links the CRT statically and exports only zvec_*.
ZVEC_SHA256_WINDOWS_X86_64=549f0893a376c8e5b4cf1e685ef55ca37f41a39f5e016632ac1f762ad703d551

# --- ONNX Runtime (the `ort` crate, load-dynamic) --------------------------------
ONNXRUNTIME_REF=v1.30.0
ONNXRUNTIME_SHA256_LINUX_X64=a5ed5a3cac51fbb2e90da632ae43d19212faaa20e76484e62bcb7c23ddb3b3fd
ONNXRUNTIME_SHA256_LINUX_X64_GPU_CUDA12=f9886932ee7bb0b4d3fcab736a392d4ff5efaa0672b47f19f0cec03437cf64f1
ONNXRUNTIME_SHA256_LINUX_X64_GPU_CUDA13=382d79133112388cf94ce5855789b7c9bef12bef76a08b6b277e5a317213adcd
ONNXRUNTIME_SHA256_LINUX_AARCH64=e16a27a8ed330bbc698df7330b0cf56e722f354e3bcc92118682c74ef3c3e3da
ONNXRUNTIME_SHA256_OSX_ARM64=6ebb5062a934537c352937821f9fe9718e7de1a2db1122a93dd363ffd53a7012
ONNXRUNTIME_SHA256_WIN_X64=c6ba983baf5681af108599675d2a89c2d145512d02de28aed0bff177cd0ba949
ONNXRUNTIME_SHA256_WIN_X64_GPU_CUDA12=d4667ea48eb0a10bc9b96b838f7b8975a6bf18de3bc5edd403a22e15c1458b23
ONNXRUNTIME_SHA256_WIN_X64_GPU_CUDA13=8fa4b08359af682cd605892cb59077049700b640128bb93fd2c7776cf9f55bdc
# Microsoft ships no aarch64 GPU build; this community wheel (Jetson AI Lab,
# sbsa/cu130) is the newest one published and carries native sm_121 cubins.
ONNXRUNTIME_AARCH64_GPU_REF=1.24.0
ONNXRUNTIME_AARCH64_GPU_URL=https://pypi.jetson-ai-lab.io/sbsa/cu130/+f/012/c10bef23a39f0/onnxruntime_gpu-1.24.0-cp312-cp312-linux_aarch64.whl
ONNXRUNTIME_AARCH64_GPU_SHA256=012c10bef23a39f074730d158b72f797a7314f2695c65835a0669b57282422f6

