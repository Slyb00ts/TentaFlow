diff --git a/src/ailego/utility/memory_helper.cc b/src/ailego/utility/memory_helper.cc
index 168c38b..5b77e16 100644
--- a/src/ailego/utility/memory_helper.cc
+++ b/src/ailego/utility/memory_helper.cc
@@ -461,6 +461,11 @@ void *MemoryHelper::AllocateAligned(size_t size, size_t alignment,
   const size_t aligned_size = (size + alignment - 1) / alignment * alignment;
 #if defined(_WIN64) || defined(_WIN32)
   void *ptr = ::_aligned_malloc(aligned_size, alignment);
+#elif defined(__ANDROID__)
+  void *ptr = nullptr;
+  if (::posix_memalign(&ptr, alignment, aligned_size) != 0) {
+    ptr = nullptr;
+  }
 #else
   void *ptr = std::aligned_alloc(alignment, aligned_size);
 #endif
diff --git a/src/core/algorithm/hnsw/hnsw_streamer_entity.cc b/src/core/algorithm/hnsw/hnsw_streamer_entity.cc
index 1ad1ebd..f4be22f 100644
--- a/src/core/algorithm/hnsw/hnsw_streamer_entity.cc
+++ b/src/core/algorithm/hnsw/hnsw_streamer_entity.cc
@@ -928,7 +928,14 @@ char *HnswContiguousStreamerEntity::allocate_contiguous(size_t size) {
   return static_cast<char *>(ptr);
 #else
   // Fallback: aligned allocation
+#if defined(__ANDROID__)
+  void *ptr = nullptr;
+  if (::posix_memalign(&ptr, ailego::MemoryHelper::PageSize(), size) != 0) {
+    ptr = nullptr;
+  }
+#else
   void *ptr = std::aligned_alloc(ailego::MemoryHelper::PageSize(), size);
+#endif
   if (!ptr) {
     LOG_ERROR("aligned_alloc failed for contiguous memory, size=%zu", size);
     return nullptr;
diff --git a/src/db/index/column/fts_column/posting/bitpacked_posting_list.cc b/src/db/index/column/fts_column/posting/bitpacked_posting_list.cc
index 9b6e3b2..0951bb2 100644
--- a/src/db/index/column/fts_column/posting/bitpacked_posting_list.cc
+++ b/src/db/index/column/fts_column/posting/bitpacked_posting_list.cc
@@ -17,6 +17,7 @@
 #include <cstdlib>
 #include <memory>
 #include <zvec/ailego/logger/logger.h>
+#include <new>
 #include "bitpacked_simd_dispatch.h"
 
 #ifdef _MSC_VER
@@ -55,9 +56,14 @@ inline auto make_aligned_uint32_array(size_t count) {
   auto *ptr = static_cast<uint32_t *>(_aligned_malloc(num_bytes, 16));
   return std::unique_ptr<uint32_t[], decltype(&_aligned_free)>(ptr,
                                                                _aligned_free);
-#else
+#elif !defined(__ANDROID__)
   auto *ptr = static_cast<uint32_t *>(std::aligned_alloc(16, num_bytes));
   return std::unique_ptr<uint32_t[], decltype(&std::free)>(ptr, std::free);
+#else
+  void *raw = nullptr;
+  if (posix_memalign(&raw, 16, num_bytes) != 0) throw std::bad_alloc();
+  auto *ptr = static_cast<uint32_t *>(raw);
+  return std::unique_ptr<uint32_t[], decltype(&std::free)>(ptr, std::free);
 #endif
 }
 
