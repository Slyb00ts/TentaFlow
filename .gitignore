# =============================================================================
# Artefakty kompilacji
# =============================================================================
target/
target_shared/
target-amd/
target-addon-wasm/
target-service-context-test/*

# Runtime data (SQLite, HMAC keys, container bundles, model cache).
# Wczesniej trzymane w target/debug/ — `cargo clean` je wywalal. Teraz
# osobny katalog `.runtime/` poza target/.
/.runtime/
/.runtime-B/
obj/
bin/
*.o
*.a
*.so
*.dylib
*.dll
*.lib
*.exe
*.wasm
plans/*

# wasm-bindgen JS glue generowany przez tentaflow-core/build.rs (jak native-libs:
# tylko zrodlo w repo, artefakt budowany lokalnie). Hashe shimow sa losowane per
# build, wiec commitowanie tych plikow powodowalo konflikt na kazdym pull/rebase.
tentaflow-core/www/js/voxel/voxel_glue.js
tentaflow-core/www/js/protocol/wasm_glue.js
tentaflow-core/www/js/protocol/wasm_glue.d.ts
tentaflow-core/www/js/protocol/wasm_glue_bg.wasm.d.ts

# Swift Package Manager + xcodebuild (mlx-swift bridge build outputs)
.build/
build-xcode/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
**/.swiftpm/xcode/xcuserdata/
DerivedData/

# Wygenerowany manifest serwisow dla GUI (build.rs produkuje przy kompilacji)
tentaflow-core/www/js/generated/
tentaflow-core/wwwroot/js/generated/

# Wygenerowany cbindgen header dla .NET P/Invoke
tentaflow-client/native/include/

# GStreamer iOS xcframework (pobierany przez scripts/setup.sh,
# install_ios_gstreamer_xcframework — ~600 MB archiwum, 1.2 GB combined lib)
tentaflow-mobile/ios/Frameworks/GStreamer.xcframework/
tentaflow-mobile/ios/Frameworks/pkgconfig/

# Android / Gradle build outputs
tentaflow-mobile/android/.gradle/
tentaflow-mobile/android/.kotlin/
tentaflow-mobile/android/build/
tentaflow-mobile/android/app/build/
tentaflow-mobile/android/app/.cxx/
tentaflow-mobile/android/.cxx/
tentaflow-mobile/android/local.properties
tentaflow-mobile/android/captures/
tentaflow-mobile/android/app/src/main/jniLibs/

# =============================================================================
# Bazy danych
# =============================================================================
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# =============================================================================
# Certyfikaty i klucze
# =============================================================================
certs/
*.pem
*.pfx
*.p12
*.key
*.crt
*.cer

# =============================================================================
# Konfiguracja lokalna (generowana przy starcie)
# =============================================================================
config.toml
*.local.toml
# Exception: .cargo/config.toml MUSI byc w repo zeby globalne build
# settings (jobs, profile defaults, linker, sccache) zadzialaly dla
# wszystkich. Nadpisuje regule `config.toml` powyzej.
!.cargo/config.toml
# To samo dla workspace tentaflow-infer: alias `cargo xtask` jest czescia
# kontraktu bramek jakosci i musi byc dostepny dla kazdego i w CI.
!tentaflow-infer/.cargo/config.toml
.env
.env.*
!.env.example

# =============================================================================
# IDE / Edytory
# =============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# =============================================================================
# Ralph Loop (stan runtime)
# =============================================================================
.ralph-state.json
.ralph-prompt-runtime.md

# =============================================================================
# Logi
# =============================================================================
*.log
logs/

# =============================================================================
# .NET artefakty
# =============================================================================
*.nupkg
*.snupkg
project.assets.json
*.nuget.*
*.AssemblyInfo.cs

# =============================================================================
# Rust specyficzne
# =============================================================================
**/*.rs.bk
Cargo.lock

# Wyjatki — Cargo.lock dla binarek (nie bibliotek)
!tentaflow/Cargo.lock
!tentaflow-desktop/Cargo.lock
!tentaflow-desktop/macos/Cargo.lock
!tentaflow-mobile/Cargo.lock
!tentaflow-memory/Cargo.lock
!tentaflow-containers/*/Cargo.lock
# Cargo binary entry points are conventionally under `src/bin/` — the
# generic `bin/` ignore above must not swallow them.
!tentaflow-sdk-gen/src/bin/
!tentaflow-sdk-gen/src/bin/**

# =============================================================================
# WASM build artefakty (addony kompilowane lokalnie)
# =============================================================================
tentaflow-core/addons/*/target/

# =============================================================================
# Test fixtures (regenerowane lokalnie przez ffmpeg — patrz README)
# =============================================================================
tentaflow-core/assets/test/sample_traffic.mp4

# =============================================================================
# Modele AI (duze pliki)
# =============================================================================
*.gguf
*.ggml
*.bin
*.safetensors
# Wagi BART (G2P fallback dla angielskiego) zwendorowanego MisakiSwift — MUSZA byc
# w repo, inaczej Kokoro TTS crashuje force-unwrapem przy pierwszym ang. slowie OOV.
!tentaflow-desktop/macos/swift/vendor/MisakiSwift/Resources/us_bart.safetensors
!tentaflow-desktop/macos/swift/vendor/MisakiSwift/Resources/gb_bart.safetensors
*.pt
*.pth
*.onnx
/models/
/tentaflow-models/models/
/mlx-models/models/
tentaflow/models

# =============================================================================
# Thirdparty (lokalne projekty referencyjne)
# =============================================================================
thirdparty/

# =============================================================================
# Addony Pro (platne — symlink do osobnego repo)
# =============================================================================
tentaflow-core/addons-pro/

# =============================================================================
# Datasety / ML treningowe
# =============================================================================
jailbreak-dataset/
*.csv

# =============================================================================
# Dokumenty tymczasowe
# =============================================================================
IMPLEMENTATION_PLAN.md
CURRENT_API.md
tests/e2e/node_modules/
tests/e2e-annot/node_modules/
tests/e2e/test-results/
test-results/
*.backup
.gstack/
notes/*.md.claude/

.claude/

# Python
__pycache__/

# Wstecznie wendorowane źródło llama.cpp — używane tylko przy LLAMA_CPP_REF=vendored.
# Nie commitujemy: kanoniczna ścieżka to pinowany SHA klonowany świeżo + prebuilt native-libs.
vendor/crates/*/llama.cpp/

# native-libs/<platform> jest w całości generowane przez scripts/native-libs/build-all.sh
# (nagłówki, lib-static, lib-dynamic, manifest.toml). Nie commitujemy żadnych artefaktów —
# każdy buduje biblioteki lokalnie. W repo zostaje tylko README.
/native-libs/*
!/native-libs/README.md

# Notatki robocze — nie wysylamy do remote (tylko katalog w korzeniu repo,
# NIE tentaflow-core/addons/notes)
/notes/

# Codex CLI session state — lokalne
.context/

# npm lockfiles — repo nie używa Node poza tests/e2e (Playwright)
package-lock.json
tests/e2e/package-lock.json

# Reference checkouts for harness analysis (not part of the project)
hermes-agent/
thirparty/

# Poufne nagrania klienta — NIE commitować (tylko lokalnie do testow rtsp-sim)
/tools/rtsp-sim/clips/

# Benchmark/experiment scratch
/scratch/
target_concurrency/
target_prefill_finish/
target_fixedk3/
target_clippy_fixed/

# Katalogi robocze buildu kerneli (publikacja podmienia je atomowo; gdy build
# zostanie przerwany, zostaja na dysku i nie moga trafic do repo).
tentaflow-infer/kernels/mojo/build/.kernel-build-*/

# Scratch Playwright (skrypty QA, zrzuty ekranu, profile przegladarki) — nigdy do repo.
# Trafialy tu tez klucze API wklejane do testow, wiec ta reguła jest zabezpieczeniem, nie porzadkami.
.pw-tmp/
